  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>3.10.4</version>
          <configuration>
            <java>
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
              </includes>
              <eclipse>
                <file>${maven.multiModuleProjectDirectory}/eclipse-format.xml</file>
              </eclipse>
              <importOrder/>
              <removeUnusedImports/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>check-formatting</id>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>validate</phase>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>io.github.ascopes</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>5.1.11</version>
        <configuration>
          <protoc>${protobuf.version}</protoc>
        </configuration>
        <executions>
          <execution>
            <id>services</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <embedSourcesInClassOutputs>true</embedSourcesInClassOutputs>
              <plugins>
                <plugin kind="jvm-maven">
                  <groupId>io.vertx</groupId>
                  <artifactId>vertx-grpc-protoc-plugin2</artifactId>
                  <version>${vertx.version}</version>
                  <mainClass>io.vertx.grpc.plugin.VertxGrpcGenerator</mainClass>
                  <options>grpc-client=true,grpc-service=false</options>
                </plugin>
              </plugins>
            </configuration>
          </execution>
          <execution>
            <id>tables</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <sourceDirectories>
                <sourceDirectory>${project.basedir}/src/main/schema</sourceDirectory>
              </sourceDirectories>
              <plugins>
                <plugin kind="jvm-maven">
                  <groupId>dev.horizon</groupId>
                  <artifactId>leadseal-protoc</artifactId>
                  <version>${leadseal.version}</version>
                  <options>migrations=${pyrite.migrations},prefix=pyrite_,dialect=postgresql,dialect=mariadb,dialect=sqlserver,dialect=sqlite</options>
                  <outputDirectory>${pyrite.migrations}</outputDirectory>
                  <registerAsCompilationRoot>false</registerAsCompilationRoot>
                </plugin>
              </plugins>
            </configuration>
          </execution>
          <execution>
            <id>acme-tables</id>
            <goals>
              <goal>generate-test</goal>
            </goals>
            <configuration>
              <javaEnabled>false</javaEnabled>
              <sourceDirectories>
                <sourceDirectory>${project.basedir}/src/test/schema</sourceDirectory>
              </sourceDirectories>
              <plugins>
                <plugin kind="jvm-maven">
                  <groupId>dev.horizon</groupId>
                  <artifactId>leadseal-protoc</artifactId>
                  <version>${leadseal.version}</version>
                  <options>migrations=${acme.migrations},prefix=acme_,dialect=postgresql,dialect=mariadb,dialect=sqlserver,dialect=sqlite</options>
                  <outputDirectory>${acme.migrations}</outputDirectory>
                  <registerAsCompilationRoot>false</registerAsCompilationRoot>
                </plugin>
              </plugins>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
