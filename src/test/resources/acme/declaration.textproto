types {
  name: "acme.dev/Binding"
  plural: "bindings"
  parents: "acme.dev/Organization"
  table: "acme_binding"
  fields { name: "name" kind: STRING }
  fields { name: "uid" kind: STRING }
  fields { name: "parent" kind: STRING }
  fields { name: "display_name" kind: STRING }
  fields { name: "labels" kind: MAP }
  fields { name: "revision" kind: INTEGER }
  fields { name: "create_time" kind: TIMESTAMP }
  fields { name: "update_time" kind: TIMESTAMP }
  fields { name: "delete_time" kind: TIMESTAMP }
  fields { name: "purge_time" kind: TIMESTAMP }
  definition {
    type: "binding"
    relations {
      key: "admin"
      value { tuple_to_userset { tupleset { relation: "parent" } computed_userset { relation: "admin" } } }
    }
    relations { key: "role" value { this {} } }
    relations { key: "member" value { this {} } }
    relations {
      key: "can_manage_stock"
      value {
        intersection {
          child { computed_userset { relation: "member" } }
          child { tuple_to_userset { tupleset { relation: "role" } computed_userset { relation: "can_manage_stock" } } }
        }
      }
    }
    metadata {
      relations { key: "role" value { directly_related_user_types { type: "role" } } }
      relations {
        key: "member"
        value {
          directly_related_user_types { type: "user" }
          directly_related_user_types { type: "group" relation: "member" }
        }
      }
    }
  }
  permissions { create: "admin" read: "admin" update: "admin" delete: "admin" grant: "admin" }
  grantable: ["role", "member"]
  retention { seconds: 2592000 }
}

types {
  name: "pyrite.dev/Key"
  parents: "acme.dev/Organization"
  definition {
    type: "key"
    relations {
      key: "admin"
      value {
        union {
          child { this {} }
          child { tuple_to_userset { tupleset { relation: "parent" } computed_userset { relation: "admin" } } }
        }
      }
    }
    relations {
      key: "viewer"
      value {
        union {
          child { this {} }
          child { computed_userset { relation: "admin" } }
          child { tuple_to_userset { tupleset { relation: "parent" } computed_userset { relation: "member" } } }
        }
      }
    }
    relations {
      key: "encrypter"
      value { union { child { this {} } child { computed_userset { relation: "admin" } } } }
    }
    relations {
      key: "decrypter"
      value { union { child { this {} } child { computed_userset { relation: "admin" } } } }
    }
    relations {
      key: "signer"
      value { union { child { this {} } child { computed_userset { relation: "admin" } } } }
    }
    relations {
      key: "verifier"
      value { union { child { this {} } child { computed_userset { relation: "signer" } } } }
    }
    metadata {
      relations { key: "admin" value { directly_related_user_types { type: "user" } } }
      relations { key: "viewer" value { directly_related_user_types { type: "user" } } }
      relations {
        key: "encrypter"
        value {
          directly_related_user_types { type: "user" }
          directly_related_user_types { type: "group" relation: "member" }
        }
      }
      relations {
        key: "decrypter"
        value {
          directly_related_user_types { type: "user" }
          directly_related_user_types { type: "group" relation: "member" }
        }
      }
      relations { key: "signer" value { directly_related_user_types { type: "user" } } }
      relations {
        key: "verifier"
        value {
          directly_related_user_types { type: "user" }
          directly_related_user_types { type: "user" wildcard {} }
        }
      }
    }
  }
  permissions { create: "admin" read: "viewer" update: "admin" delete: "admin" grant: "admin" }
  grantable: ["admin", "viewer", "encrypter", "decrypter", "signer", "verifier"]
  creator: "admin"
  retention { seconds: 2592000 }
}

types {
  name: "pyrite.dev/Account"
  definition {
    type: "user"
    relations { key: "owner" value { this {} } }
    relations {
      key: "admin"
      value { union { child { this {} } child { computed_userset { relation: "owner" } } } }
    }
    relations {
      key: "viewer"
      value { union { child { this {} } child { computed_userset { relation: "admin" } } } }
    }
    metadata {
      relations { key: "owner" value { directly_related_user_types { type: "user" } } }
      relations { key: "admin" value { directly_related_user_types { type: "user" } } }
      relations { key: "viewer" value { directly_related_user_types { type: "user" } } }
