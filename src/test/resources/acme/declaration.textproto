conditions {
  key: "not_expired"
  value {
    name: "not_expired"
    expression: "current_time < expires_at"
    parameters { key: "current_time" value { type_name: TYPE_NAME_TIMESTAMP } }
    parameters { key: "expires_at" value { type_name: TYPE_NAME_TIMESTAMP } }
  }
}

flows { name: "sign-in" input: IDENTIFIER stages { factors: 1 } completes: ISSUE_SESSION }
flows { name: "sign-in-with-two-factors" input: IDENTIFIER stages { factors: 2 } completes: ISSUE_SESSION }
flows { name: "verify" input: SUBJECT_IDENTIFIER stages { identifier: true } completes: MARK_VERIFIED }
flows {
  name: "recover"
  input: IDENTIFIER
  stages { identifier: true }
  stages { enrol: PASSWORD }
  completes: [ACTIVATE_FACTOR, END_SESSIONS]
}
flows { name: "enrol-password" input: SUBJECT stages { enrol: PASSWORD } completes: ACTIVATE_FACTOR }
flows { name: "enrol-totp" input: SUBJECT stages { enrol: TOTP } completes: ACTIVATE_FACTOR }
flows { name: "enrol-recovery-codes" input: SUBJECT stages { enrol: RECOVERY_CODES } completes: ACTIVATE_FACTOR }
