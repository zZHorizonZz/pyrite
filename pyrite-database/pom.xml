<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.horizon</groupId>
    <artifactId>pyrite-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pyrite-database</artifactId>
  <name>Pyrite - Database</name>
  <description>The provider that keeps keys in a PostgreSQL, MariaDB, SQL Server or SQLite database through Cinder,
    under a vault key encrypted by your root key.</description>

  <properties>
    <pyrite.migrations>${project.basedir}/src/main/resources/pyrite/migration</pyrite.migrations>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.horizon</groupId>
      <artifactId>pyrite-internal</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.horizon</groupId>
      <artifactId>cinder-database</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.horizon</groupId>
      <artifactId>cinder-extension-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.horizon</groupId>
      <artifactId>leadseal-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.crypto.tink</groupId>
      <artifactId>tink</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-sql-client</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.horizon</groupId>
      <artifactId>pyrite-internal</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.horizon</groupId>
      <artifactId>cinder-database-sqlite</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-jdbc-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.github.ascopes</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>5.1.11</version>
        <configuration>
          <protoc>${protobuf.version}</protoc>
        </configuration>
        <executions>
          <execution>
            <id>tables</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <sourceDirectories>
                <sourceDirectory>${project.basedir}/src/main/schema</sourceDirectory>
              </sourceDirectories>
              <plugins>
                <plugin kind="jvm-maven">
                  <groupId>dev.horizon</groupId>
                  <artifactId>leadseal-protoc</artifactId>
                  <version>${leadseal.version}</version>
                  <options>migrations=${pyrite.migrations},prefix=pyrite_,dialect=postgresql,dialect=mariadb,dialect=sqlserver,dialect=sqlite</options>
                  <outputDirectory>${pyrite.migrations}</outputDirectory>
                  <registerAsCompilationRoot>false</registerAsCompilationRoot>
                </plugin>
              </plugins>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
